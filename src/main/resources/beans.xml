<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">


    <bean id="gameRepository" class="com.sedlacek.quiz.repository.GameRepository"/>

    <bean id="userRepository" class="com.sedlacek.quiz.repository.UserRepository"/>

    <bean id="countryRepository" class="com.sedlacek.quiz.repository.CountryRepository"/>

    <bean id="gameService" class="com.sedlacek.quiz.service.impl.GameServiceImpl">
        <constructor-arg name="gameRepository" ref="gameRepository"/>
        <constructor-arg name="userRepository" ref="userRepository"/>
        <constructor-arg name="countryRepository" ref="countryRepository"/>
    </bean>

    <bean id="userService" class="com.sedlacek.quiz.service.impl.UserServiceImpl">
        <constructor-arg name="userRepository" ref="userRepository"/>
        <constructor-arg name="javaMailSender" ref="javaMailSender"/>
        <constructor-arg name="validator" ref="userValidator"/>
    </bean>

    <bean id="countryService" class="com.sedlacek.quiz.service.impl.CountryServiceImpl">
        <constructor-arg name="countryRepository" ref="countryRepository"/>
    </bean>

    <bean id="userValidator" class="com.sedlacek.quiz.validator.UserValidator">
        <constructor-arg name="userRepository" ref="userRepository"/>
    </bean>

    <bean id="javaMailSender" class="org.springframework.mail.javamail.JavaMailSenderImpl">
        <property name="host" value="smtp.seznam.cz"/>
        <property name="port" value="465"/>
        <property name="username" value="quizapp@seznam.cz"/>
        <property name="password" value="Quizapp123*"/>
        <property name="javaMailProperties">
            <props>
                <prop key="mail.transport.protocol">smtp</prop>
                <prop key="mail.smtp.auth">true</prop>
                <prop key="mail.smtp.starttls.enable">true</prop>
                <prop key="mail.smtp.ssl.enable">true</prop>
            </props>
        </property>
    </bean>

</beans>